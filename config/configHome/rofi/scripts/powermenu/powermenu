#!/usr/bin/env bash

uptime="$(uptime -p)"
uptime="${uptime#up }"

shutdown='󰐥'
reboot='󰜉'
lock=''
suspend='󰤄'
logout='󰍃'
yes='󰸞'
no='󱎘'

theme="$HOME/.config/rofi/scripts/powermenu/style.rasi"

rofi_cmd() {
  rofi -dmenu \
    -p "Uptime: $uptime" \
    -mesg "Uptime: $uptime" \
    -theme "$theme"
}

confirm_cmd() {
  rofi -theme-str 'window {location: center; anchor: center; fullscreen: false; width: 350px;}' \
    -theme-str 'mainbox {children: [ "message", "listview" ];}' \
    -theme-str 'listview {columns: 2; lines: 1;}' \
    -theme-str 'element-text {horizontal-align: 0.5;}' \
    -theme-str 'textbox {horizontal-align: 0.5;}' \
    -dmenu \
    -mesg 'Are you sure?' \
    -theme "$theme"
}

chosen="$(echo -e "$lock\n$suspend\n$logout\n$reboot\n$shutdown" | rofi_cmd)"
[[ -z "$chosen" ]] && exit 0

selected="$(echo -e "$yes\n$no" | confirm_cmd)"
[[ "$selected" != "$yes" ]] && exit 0

case "$chosen" in
"$shutdown")
  systemctl poweroff
  ;;
"$reboot")
  systemctl reboot
  ;;
"$suspend")
  mpc -q pause
  systemctl hibernate
  if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then hyprlock; else swaylock; fi
  ;;
"$logout")
  if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then hyprctl dispatch exit; else swaymsg exit; fi
  ;;
"$lock")
  # pkill -f "kitty --class Screensaver"
  if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then hyprlock; else swaylock; fi
  ;;
esac